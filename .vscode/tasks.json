{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Android Emulator (Pixel_10_Pro)",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start_android_emulator.ps1",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": false
      },
      "group": "none"
    },
    {
      "label": "Restart Android Emulator (Pixel_10_Pro)",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start_android_emulator.ps1 -ForceRestart",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": false
      },
      "group": "none"
    }
  ]
}
